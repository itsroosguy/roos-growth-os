# ==============================================================================
# WHATSAPP CRM & AUTOMATION SAAS - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & DOMAIN
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. SUPABASE INFRASTRUCTURE (Required)
# ------------------------------------------------------------------------------
# Supabase project URL (Public - safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase public anonymous key (Public - safe for browser, protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (SERVER ONLY - NEVER expose to browser)
# Used exclusively for system operations, secure cron jobs, and background workers
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Direct PostgreSQL database connection URL (Used for migrations)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 3. BACKGROUND JOBS & CRON SCHEDULING
# ------------------------------------------------------------------------------
# Secret token to protect the cron runner endpoint (/api/cron/process-jobs)
CRON_SECRET=generate_a_secure_random_cron_secret_key_here

# ------------------------------------------------------------------------------
# 4. SUBSCRIPTION & BILLING
# ------------------------------------------------------------------------------
# 'development' allows full feature simulation without payment gateways
# 'live' enforces payment webhook validation and strict subscription quotas
SUBSCRIPTION_MODE=development

# ------------------------------------------------------------------------------
# 5. CREDENTIAL ENCRYPTION (At-Rest Security)
# ------------------------------------------------------------------------------
# 32-byte hex key for encrypting tenant WhatsApp access tokens in PostgreSQL
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# 6. META WHATSAPP CLOUD API (Optional for Milestone 1-6; Required for Milestone 7 Live Mode)
# Note: In Milestone 6, development uses the built-in Mock WhatsApp Provider.
# ------------------------------------------------------------------------------
META_WA_PHONE_NUMBER_ID=
META_WA_BUSINESS_ACCOUNT_ID=
META_WA_ACCESS_TOKEN=
META_WA_WEBHOOK_VERIFY_TOKEN=
META_WA_APP_SECRET=
